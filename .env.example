# Base URL of the Nexus backend API (the Go server started with `nexus --api`).
# In dev, Vite proxies `/api` to http://localhost:8080, so the default works.
VITE_API_BASE_URL=http://localhost:8080/api

# Supabase Auth (optional) — when both are set, the dashboard is behind a login
# wall and the API attaches the session token. Leave both unset for local
# auth-disabled development (the backend must also run without
# NEXUS_SUPABASE_JWT_SECRET).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

